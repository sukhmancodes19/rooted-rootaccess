# Google Gemini API Key
# Obtain your key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Groq API Key (optional fallback if all Gemini models are unavailable)
# Obtain your key from https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# WAQI (World Air Quality Index) Token for ground station readings
# Obtain your free API token from https://aqicn.org/data-platform/token/
WAQI_TOKEN=your_waqi_api_token_here
